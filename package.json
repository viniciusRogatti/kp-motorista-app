{
  "name": "kp-motorista-app",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "dependencies": {
    "@expo/ui": "~56.0.24",
    "expo": "~56.0.18",
    "expo-application": "~56.0.3",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.22",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "~56.0.23",
    "expo-linking": "~56.0.16",
    "expo-location": "~56.0.22",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.22",
    "expo-router": "~56.2.17",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.24",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest-expo": "~56.0.5",
    "patch-package": "^8.0.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "prebuild": "expo prebuild --platform android",
    "prebuild:clean": "expo prebuild --clean --platform android",
    "postinstall": "patch-package",
    "doctor": "npx expo-doctor",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "build:development": "npx eas-cli build --platform android --profile development",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "build:production": "npx eas-cli build --platform android --profile production"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/__tests__"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/android/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/"
    ]
  }
}
