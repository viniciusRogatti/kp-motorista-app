{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": {
    "version": ">= 16.17.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_BUILD_CHANNEL": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://kptransportes-backend.up.railway.app",
        "EXPO_PUBLIC_SOCKET_URL": "https://kptransportes-backend.up.railway.app",
        "EXPO_PUBLIC_BUILD_CHANNEL": "preview",
        "EXPO_PUBLIC_OPERATIONS_MODE": "live"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_BUILD_CHANNEL": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
