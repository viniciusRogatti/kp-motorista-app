# development | preview | production
APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Use o IP LAN do computador no aparelho fisico, por exemplo http://192.168.1.50:3001.
# Development e Preview devem apontar para homologacao, nunca silenciosamente para producao.
EXPO_PUBLIC_API_URL=http://192.168.1.50:3001
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.50:3001
EXPO_PUBLIC_BUILD_CHANNEL=development
# observation | simulation | live
EXPO_PUBLIC_OPERATIONS_MODE=observation
EXPO_PUBLIC_MAP_PROVIDER=external

# O DSN do cliente pode ser publico. Nao coloque auth token do Sentry aqui.
EXPO_PUBLIC_SENTRY_DSN=

# Preenchido somente depois de executar `eas init` manualmente.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Definir somente depois de aprovar o identificador definitivo.
ANDROID_PACKAGE_NAME=com.suaempresa.kpmotorista

# Metadados opcionais de CI; nao sao segredos.
BUILD_DATE=
GIT_COMMIT_SHA=

# NUNCA use EXPO_PUBLIC_* para senhas, JWT_SECRET, credenciais de banco,
# chaves administrativas, service accounts ou tokens privados.
